# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site URL (for production - used in metadata)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Resend - https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key
# Optional overrides
# CONTACT_TO_EMAIL=contact@mototrip.pt
# CONTACT_FROM_EMAIL="MotoTrip <contact@mototrip.pt>"
# CURATOR_NOTIFY_EMAIL=curator@mototrip.pt

# Route builder: road routing between the points drawn on the map
# (OpenRouteService free plan - https://openrouteservice.org/dev/#/signup)
# Without it the builder still works, joining the points with straight lines.
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key
