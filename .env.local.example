# ============================================================================
# Mototrip Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key (use for server-side operations only)
# IMPORTANT: Keep this secret! Never commit to version control
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anonymous/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# Optional: Google Maps Configuration
# ============================================================================
# Required for map features in the UI
# Get your API key from: https://console.cloud.google.com/

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================================================
# Optional: External APIs
# ============================================================================
# For enhanced elevation data (recommended for production)

# Open-Elevation API (free, no key required)
# ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# Or use Mapbox for more accurate data
# MAPBOX_ACCESS_TOKEN=your-mapbox-token

# ============================================================================
# Development Settings
# ============================================================================

# Next.js environment
NODE_ENV=development

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
